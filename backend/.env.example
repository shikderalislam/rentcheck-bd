NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/rentcheck_bd

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=rc_token

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Future integrations (not required for MVP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
MAPBOX_TOKEN=
EMAIL_API_KEY=
